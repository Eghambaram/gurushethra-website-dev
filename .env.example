# Supabase — database + auth for the admin CMS.
# Project settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit — image hosting/CDN for admin-uploaded media.
# Developer options in the ImageKit dashboard.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Server-only.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Resend API key — sends contact form submissions to gurushethra1991@gmail.com.
# Get one at https://resend.com/api-keys (free tier is enough for this).
RESEND_API_KEY=

# Optional. Secures the /api/cron/keep-alive route (see vercel.json) so only
# Vercel's own scheduled invocation can trigger it — Vercel automatically sends
# this as an Authorization: Bearer header when the cron fires. Any random
# string works; generate one with `openssl rand -hex 32`. Safe to leave unset
# in local dev — the route just skips the check.
CRON_SECRET=
